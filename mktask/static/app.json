{
  "app": {
    "title": "mktask",
    "theme": "dark"
  },
  "state": {
    "status": {
      "message": "Connecting...",
      "background": "#858585",
      "color": "#000"
    },
    "selected_task": null,
    "selected_ref": null
  },
  "menubar": [
    {
      "label": "Tasks",
      "items": [
        {
          "label": "Tasks",
          "action": "pane.show",
          "args": "tasks"
        },
        {
          "label": "Detail",
          "action": "pane.show",
          "args": "task-detail"
        },
        {
          "label": "References",
          "action": "pane.show",
          "args": "references"
        },
        {
          "label": "Relations",
          "action": "pane.show",
          "args": "relations"
        },
        {
          "sep": true
        },
        {
          "label": "Show Open Only",
          "action": "table.filter",
          "args": {
            "pane": "tasks",
            "filters": {
              "status": [
                "open"
              ]
            },
            "merge": true
          }
        },
        {
          "label": "Show All",
          "action": "table.filter",
          "args": {
            "pane": "tasks",
            "filters": {
              "status": null
            },
            "merge": true
          }
        },
        {
          "sep": true
        },
        {
          "label": "Expand All",
          "action": "table.expand",
          "args": {
            "pane": "tasks",
            "depth": "all"
          }
        },
        {
          "label": "Collapse All",
          "action": "table.expand",
          "args": {
            "pane": "tasks"
          }
        }
      ]
    },
    {
      "label": "Edit",
      "items": [
        {
          "label": "Copy",
          "action": "edit.copy",
          "shortcut": "mod+C"
        },
        {
          "label": "Select All",
          "action": "edit.selectAll",
          "shortcut": "mod+A"
        }
      ]
    },
    {
      "label": "Layout",
      "items": [
        {
          "label": "Save Layout",
          "action": "layout.save"
        },
        {
          "label": "Restore Layout",
          "layouts": true
        },
        {
          "sep": true
        },
        {
          "label": "Reset to Default",
          "action": "layout.reset"
        }
      ]
    },
    {
      "label": "Window",
      "items": [
        {
          "label": "Cascade",
          "action": "window.cascade"
        },
        {
          "label": "Tile",
          "items": [
            {
              "label": "Horizontal",
              "action": "window.tileH"
            },
            {
              "label": "Vertical",
              "action": "window.tileV"
            },
            {
              "label": "Grid",
              "action": "window.grid"
            }
          ]
        },
        {
          "sep": true
        },
        {
          "windows": true
        }
      ]
    }
  ],
  "statusbar": {
    "left": [
      {
        "type": "text",
        "bind": "status.message"
      }
    ],
    "right": [
      {
        "type": "text",
        "text": "mktask"
      }
    ],
    "bindStyle": {
      "color": "status.color",
      "background": "status.background"
    }
  },
  "layouts": {
    "key": "mktask",
    "keep": 10,
    "keepDays": 7
  },
  "panes": {
    "tasks": {
      "title": "Tasks",
      "type": "mkio-table",
      "service": "all_tasks",
      "protocol": "query",
      "columns": [
        "task_id",
        "title",
        "score",
        "importance",
        "urgency",
        "due",
        "status",
        "created_at"
      ],
      "labels": {
        "task_id": "Task ID",
        "title": "Title",
        "score": "Score",
        "importance": "Imp",
        "urgency": "Urg",
        "due": "Due",
        "status": "Status",
        "created_at": "Created"
      },
      "values": {
        "score": "importance * urgency"
      },
      "types": {
        "due": "time",
        "created_at": {
          "type": "time",
          "parse": "%Y-%m-%d %H:%M:%S"
        }
      },
      "tree": {
        "child": "parent_task_id",
        "parent": "task_id",
        "column": "task_id",
        "expand": "all",
        "filterScope": "all"
      },
      "sort": [
        "-score",
        "created_at"
      ],
      "filters": {
        "status": [
          "open"
        ]
      },
      "styles": {
        "score": [
          {
            "when": "value >= 16",
            "color": "#f44747",
            "bold": true
          },
          {
            "when": "value >= 9",
            "color": "#dcdcaa"
          },
          {
            "color": "#858585"
          }
        ],
        "status": [
          {
            "when": "value == 'complete'",
            "color": "#4ec9b0"
          }
        ]
      },
      "rowStyle": [
        {
          "when": "status == 'complete'",
          "color": "#858585",
          "strike": true
        }
      ],
      "select": {
        "state": "selected_task"
      },
      "buttons": [
        {
          "label": "New",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "New Task",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "title",
                  "label": "Title",
                  "type": "text",
                  "required": true,
                  "placeholder": "What needs doing?"
                },
                {
                  "row": [
                    {
                      "name": "importance",
                      "label": "Importance",
                      "type": "select",
                      "width": 0.5,
                      "value": 3,
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    },
                    {
                      "name": "urgency",
                      "label": "Urgency",
                      "type": "select",
                      "width": 0.5,
                      "value": 3,
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "due",
                  "label": "Due (YYYY-MM-DD, optional)",
                  "type": "text",
                  "placeholder": "2026-12-31",
                  "value": ""
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": ""
                }
              ],
              "submit": {
                "label": "Create",
                "service": "tasks",
                "op": "add"
              }
            }
          }
        },
        {
          "label": "Edit",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Edit Task ID ${row.task_id}",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "name": "updated_at",
                  "type": "hidden",
                  "value": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "type": "text",
                  "required": true,
                  "placeholder": "What needs doing?",
                  "value": "${row.title}"
                },
                {
                  "row": [
                    {
                      "name": "importance",
                      "label": "Importance",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.importance}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    },
                    {
                      "name": "urgency",
                      "label": "Urgency",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.urgency}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "due",
                  "label": "Due (YYYY-MM-DD, optional)",
                  "type": "text",
                  "placeholder": "2026-12-31",
                  "value": "${row.due}"
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": "${row.notes}"
                }
              ],
              "submit": {
                "label": "Save",
                "service": "tasks",
                "op": "edit"
              }
            }
          }
        },
        {
          "label": "Move",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Move Task ID ${row.task_id}",
              "modal": true,
              "width": 600,
              "fields": [
                {
                  "name": "task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "name": "updated_at",
                  "type": "hidden",
                  "value": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
                },
                {
                  "label": "Task",
                  "type": "readonly",
                  "value": "${row.title}"
                },
                {
                  "label": "Now",
                  "type": "readonly",
                  "value": "${IF(row.parent_task_id == '', 'top level', CONCAT('split from Task ID ', row.parent_task_id))}"
                },
                {
                  "name": "parent_task_id",
                  "label": "Parent",
                  "type": "select",
                  "required": true,
                  "optionsFrom": {
                    "service": "move_options",
                    "params": {
                      "task_id": "${row.task_id}"
                    },
                    "value": "value",
                    "label": "label"
                  }
                }
              ],
              "footer": {
                "note": "A moved task takes every task split from it along."
              },
              "submit": {
                "label": "Move",
                "service": "tasks",
                "op": "move"
              }
            }
          }
        },
        {
          "label": "Split",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Split Task ID ${row.task_id}",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "parent_task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "label": "Parent",
                  "type": "readonly",
                  "value": "${row.title}"
                },
                {
                  "name": "title",
                  "label": "Child task title",
                  "type": "text",
                  "required": true,
                  "placeholder": "What part of it needs doing?"
                },
                {
                  "row": [
                    {
                      "name": "importance",
                      "label": "Importance",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.importance}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    },
                    {
                      "name": "urgency",
                      "label": "Urgency",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.urgency}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "due",
                  "label": "Due (YYYY-MM-DD, optional)",
                  "type": "text",
                  "placeholder": "2026-12-31",
                  "value": "${row.due}"
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": ""
                }
              ],
              "submit": {
                "label": "Split",
                "service": "tasks",
                "op": "split"
              }
            }
          }
        },
        {
          "label": "Reference",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Add ${IF(kind == 'task', 'task link', IF(kind == 'url', 'URL', 'text'))} to Task ID ${row.task_id}",
              "modal": true,
              "width": 460,
              "fields": [
                {
                  "name": "task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "label": "Task",
                  "type": "readonly",
                  "value": "${row.title}"
                },
                {
                  "name": "kind",
                  "label": "Kind",
                  "type": "select",
                  "value": "url",
                  "options": [
                    {
                      "value": "url",
                      "label": "URL"
                    },
                    {
                      "value": "text",
                      "label": "Text snippet"
                    },
                    {
                      "value": "task",
                      "label": "Link to another task"
                    }
                  ]
                },
                {
                  "name": "_url",
                  "label": "URL",
                  "type": "text",
                  "required": true,
                  "placeholder": "https://…, mailto:…",
                  "showWhen": "kind == 'url'"
                },
                {
                  "name": "body",
                  "label": "Text",
                  "type": "textarea",
                  "required": true,
                  "placeholder": "Paste the email or conversation here",
                  "showWhen": "kind == 'text'"
                },
                {
                  "name": "relation",
                  "label": "This task …",
                  "type": "select",
                  "required": true,
                  "showWhen": "kind == 'task'",
                  "optionsFrom": {
                    "service": "relation_options",
                    "value": "value",
                    "label": "label"
                  }
                },
                {
                  "name": "_task",
                  "label": "… that task",
                  "type": "select",
                  "required": true,
                  "showWhen": "kind == 'task'",
                  "optionsFrom": {
                    "service": "task_options",
                    "params": {
                      "task_id": "${row.task_id}"
                    },
                    "value": "value",
                    "label": "label"
                  }
                },
                {
                  "name": "href",
                  "type": "hidden",
                  "compute": "IF(kind == 'task', _task, IF(kind == 'url', _url, ''))"
                },
                {
                  "name": "label",
                  "label": "Label",
                  "type": "text",
                  "showWhen": "kind != 'task'",
                  "compute": "IF(kind == 'url', _url, FIRST(FILTER(SPLIT(body ?? '', '\\n'), l -> TRIM(l) != '')) ?? '')",
                  "placeholder": "What to show for it"
                }
              ],
              "footer": {
                "note": "${IF(kind == 'task', 'The link shows on both tasks, worded from each side. Relations are edited under Tasks › Relations.', 'Files: drop, paste, or pick them in the Detail pane.')}"
              },
              "submit": {
                "label": "Add",
                "service": "tasks",
                "op": "add_ref"
              }
            }
          }
        },
        {
          "label": "Complete",
          "enable": {
            "connected": true,
            "minSelected": 1,
            "when": "ALL(rows, r -> r.status == 'open')"
          },
          "action": {
            "type": "transaction",
            "service": "tasks",
            "op": "complete",
            "data": {
              "task_id": "${row.task_id}",
              "completed_at": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}",
              "updated_at": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
            }
          }
        },
        {
          "label": "Reopen",
          "enable": {
            "connected": true,
            "minSelected": 1,
            "when": "ALL(rows, r -> r.status == 'complete')"
          },
          "action": {
            "type": "transaction",
            "service": "tasks",
            "op": "reopen",
            "data": {
              "task_id": "${row.task_id}",
              "updated_at": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
            }
          }
        },
        {
          "label": "Delete",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "style": [
            {
              "when": "enabled",
              "background": "#c62828",
              "color": "#fff"
            }
          ],
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Delete Task ID ${row.task_id}",
              "modal": true,
              "width": 380,
              "fields": [
                {
                  "name": "task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "label": "Delete this task and every task split from it?",
                  "type": "readonly",
                  "value": "${row.title}"
                }
              ],
              "submit": {
                "label": "Delete",
                "service": "tasks",
                "op": "delete"
              }
            }
          }
        }
      ],
      "link": {
        "broadcast": {
          "task_id": "task_id"
        },
        "chips": false
      }
    },
    "task-detail": {
      "title": "Detail",
      "widgets": [
        {
          "type": "task-refs",
          "class": "task-detail-refs",
          "reveal": true,
          "dialogs": {
            "editTask": {
              "pane": "tasks",
              "button": "Edit"
            },
            "editRef": {
              "pane": "references",
              "button": "Edit"
            },
            "deleteRef": {
              "pane": "references",
              "button": "Delete"
            }
          }
        }
      ]
    },
    "references": {
      "title": "References",
      "type": "mkio-table",
      "service": "task_refs",
      "protocol": "query",
      "columns": [
        "task_id",
        "kind",
        "relation",
        "label",
        "created_at"
      ],
      "labels": {
        "task_id": "Task ID",
        "kind": "Kind",
        "relation": "Relation",
        "label": "Reference",
        "created_at": "Added"
      },
      "display": {
        "label": "${IF(kind == 'task', CONCAT(href, '  ', label), IF(href == '', label, LINK(label, href)))}"
      },
      "types": {
        "created_at": {
          "type": "time",
          "parse": "%Y-%m-%d %H:%M:%S"
        }
      },
      "sort": [
        "-created_at"
      ],
      "styles": {
        "kind": [
          {
            "when": "value == 'task'",
            "color": "#4ec9b0"
          },
          {
            "when": "value == 'file'",
            "color": "#dcdcaa"
          },
          {
            "color": "#858585"
          }
        ]
      },
      "select": {
        "state": "selected_ref"
      },
      "buttons": [
        {
          "label": "Edit",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Edit ${IF(row.kind == 'task', 'task link', row.kind)} reference",
              "modal": true,
              "width": 460,
              "fields": [
                {
                  "name": "ref_id",
                  "type": "hidden",
                  "value": "${row.ref_id}"
                },
                {
                  "name": "updated_at",
                  "type": "hidden",
                  "value": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
                },
                {
                  "label": "Task ID",
                  "type": "readonly",
                  "value": "${row.task_id}"
                },
                {
                  "label": "Linked task",
                  "type": "readonly",
                  "value": "${row.href}  ${row.label}",
                  "showWhen": "row.kind == 'task'"
                },
                {
                  "name": "relation",
                  "label": "This task …",
                  "type": "select",
                  "required": true,
                  "value": "${row.relation}",
                  "showWhen": "row.kind == 'task'",
                  "optionsFrom": {
                    "service": "relation_options",
                    "value": "value",
                    "label": "label"
                  }
                },
                {
                  "name": "label",
                  "label": "Label",
                  "type": "text",
                  "value": "${row.label}",
                  "showWhen": "row.kind != 'task'"
                },
                {
                  "name": "href",
                  "label": "URL",
                  "type": "text",
                  "required": true,
                  "value": "${row.href}",
                  "showWhen": "row.kind == 'url'"
                },
                {
                  "name": "body",
                  "label": "Text",
                  "type": "textarea",
                  "required": true,
                  "value": "${row.body}",
                  "showWhen": "row.kind == 'text'"
                }
              ],
              "submit": {
                "label": "Save",
                "service": "tasks",
                "op": "edit_ref"
              }
            }
          }
        },
        {
          "label": "Delete",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "style": [
            {
              "when": "enabled",
              "background": "#c62828",
              "color": "#fff"
            }
          ],
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Delete Reference",
              "modal": true,
              "width": 380,
              "fields": [
                {
                  "name": "ref_id",
                  "type": "hidden",
                  "value": "${row.ref_id}"
                },
                {
                  "label": "Remove this reference from Task ID ${row.task_id}? A task link is removed from both tasks.",
                  "type": "readonly",
                  "value": "${row.label}"
                }
              ],
              "submit": {
                "label": "Delete",
                "service": "tasks",
                "op": "delete_ref"
              }
            }
          }
        }
      ],
      "link": {
        "listen": {
          "task_id": "task_id"
        },
        "chips": false
      }
    },
    "relations": {
      "title": "Relations",
      "type": "mkio-table",
      "service": "all_relations",
      "protocol": "query",
      "columns": [
        "forward",
        "backward",
        "notes"
      ],
      "labels": {
        "forward": "This task …",
        "backward": "… that task",
        "notes": "Notes"
      },
      "sort": [
        "forward"
      ],
      "buttons": [
        {
          "label": "New",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "New Relation",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "forward",
                  "label": "This task … that task",
                  "type": "text",
                  "required": true,
                  "placeholder": "blocks",
                  "value": ""
                },
                {
                  "name": "backward",
                  "label": "That task … this task",
                  "type": "text",
                  "placeholder": "${forward} (leave blank if it reads the same both ways)"
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": ""
                }
              ],
              "footer": {
                "note": "A link reads \"A ${forward ?? '…'} B\" on one task and \"B ${IF(TRIM(backward ?? '') == '', forward ?? '…', backward)} A\" on the other."
              },
              "submit": {
                "label": "Create",
                "service": "tasks",
                "op": "add_relation"
              }
            }
          }
        },
        {
          "label": "Edit",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Edit Relation",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "relation_id",
                  "type": "hidden",
                  "value": "${row.relation_id}"
                },
                {
                  "name": "updated_at",
                  "type": "hidden",
                  "value": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
                },
                {
                  "name": "forward",
                  "label": "This task … that task",
                  "type": "text",
                  "required": true,
                  "placeholder": "blocks",
                  "value": "${row.forward}"
                },
                {
                  "name": "backward",
                  "label": "That task … this task",
                  "type": "text",
                  "placeholder": "${forward} (leave blank if it reads the same both ways)",
                  "value": "${IF(row.forward == row.backward, '', row.backward)}"
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": "${row.notes}"
                }
              ],
              "footer": {
                "note": "Renaming rewrites every link that uses this relation."
              },
              "submit": {
                "label": "Save",
                "service": "tasks",
                "op": "edit_relation"
              }
            }
          }
        },
        {
          "label": "Delete",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "style": [
            {
              "when": "enabled",
              "background": "#c62828",
              "color": "#fff"
            }
          ],
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Delete Relation",
              "modal": true,
              "width": 380,
              "fields": [
                {
                  "name": "relation_id",
                  "type": "hidden",
                  "value": "${row.relation_id}"
                },
                {
                  "label": "Delete this relation? Refused while any link uses it.",
                  "type": "readonly",
                  "value": "${row.forward} / ${row.backward}"
                }
              ],
              "submit": {
                "label": "Delete",
                "service": "tasks",
                "op": "delete_relation"
              }
            }
          }
        }
      ]
    }
  },
  "frames": [
    {
      "id": "main",
      "x": 0.02,
      "y": 0.03,
      "w": 0.64,
      "h": 0.94,
      "layout": {
        "type": "split",
        "dir": "v",
        "ratios": [
          0.65,
          0.35
        ],
        "children": [
          {
            "type": "tabs",
            "active": 0,
            "children": [
              "tasks"
            ]
          },
          {
            "type": "tabs",
            "active": 0,
            "children": [
              "references"
            ]
          }
        ]
      }
    },
    {
      "id": "side",
      "x": 0.68,
      "y": 0.03,
      "w": 0.3,
      "h": 0.94,
      "layout": {
        "type": "tabs",
        "active": 0,
        "children": [
          "task-detail"
        ]
      }
    }
  ],
  "mkio": {
    "url": "auto",
    "expect": {
      "name": "mktask",
      "expr": "1"
    },
    "connected": {
      "status.message": "Connected",
      "status.color": null,
      "status.background": null
    },
    "disconnected": {
      "status.message": "Disconnected",
      "status.color": "#000",
      "status.background": "#858585"
    },
    "incompatible": {
      "status.message": "Server mismatch",
      "status.color": "#fff",
      "status.background": "#cc0000"
    }
  }
}
