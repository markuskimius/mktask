{
  "app": {
    "title": "mktask",
    "theme": "dark"
  },
  "state": {
    "status": {
      "message": "Connecting...",
      "background": "#858585",
      "color": "#000"
    },
    "selected_task": null
  },
  "menubar": [
    {
      "label": "Edit",
      "items": [
        {
          "label": "Copy",
          "action": "edit.copy",
          "shortcut": "mod+C"
        },
        {
          "label": "Select All",
          "action": "edit.selectAll",
          "shortcut": "mod+A"
        }
      ]
    },
    {
      "label": "Tasks",
      "items": [
        {
          "label": "Tasks",
          "action": "pane.show",
          "args": "tasks"
        },
        {
          "label": "Detail",
          "action": "pane.show",
          "args": "task-detail"
        },
        {
          "sep": true
        },
        {
          "label": "Show Open Only",
          "action": "table.filter",
          "args": {
            "pane": "tasks",
            "filters": {
              "status": [
                "open"
              ]
            },
            "merge": true
          }
        },
        {
          "label": "Show All",
          "action": "table.filter",
          "args": {
            "pane": "tasks",
            "filters": {
              "status": null
            },
            "merge": true
          }
        },
        {
          "sep": true
        },
        {
          "label": "Expand All",
          "action": "table.expand",
          "args": {
            "pane": "tasks",
            "depth": "all"
          }
        },
        {
          "label": "Collapse All",
          "action": "table.expand",
          "args": {
            "pane": "tasks"
          }
        }
      ]
    },
    {
      "label": "Layout",
      "items": [
        {
          "label": "Save Layout",
          "action": "layout.save"
        },
        {
          "label": "Restore Layout",
          "layouts": true
        },
        {
          "sep": true
        },
        {
          "label": "Reset to Default",
          "action": "layout.reset"
        }
      ]
    },
    {
      "label": "Window",
      "items": [
        {
          "label": "Cascade",
          "action": "window.cascade"
        },
        {
          "label": "Tile",
          "items": [
            {
              "label": "Horizontal",
              "action": "window.tileH"
            },
            {
              "label": "Vertical",
              "action": "window.tileV"
            },
            {
              "label": "Grid",
              "action": "window.grid"
            }
          ]
        },
        {
          "sep": true
        },
        {
          "windows": true
        }
      ]
    }
  ],
  "statusbar": {
    "left": [
      {
        "type": "text",
        "bind": "status.message"
      }
    ],
    "right": [
      {
        "type": "text",
        "text": "mktask"
      }
    ],
    "bindStyle": {
      "color": "status.color",
      "background": "status.background"
    }
  },
  "layouts": {
    "key": "mktask",
    "keep": 10,
    "keepDays": 7
  },
  "panes": {
    "tasks": {
      "title": "Tasks",
      "type": "mkio-table",
      "service": "all_tasks",
      "protocol": "query",
      "columns": [
        "task_id",
        "title",
        "score",
        "importance",
        "urgency",
        "due",
        "status",
        "created_at"
      ],
      "labels": {
        "task_id": "Task ID",
        "title": "Title",
        "score": "Score",
        "importance": "Imp",
        "urgency": "Urg",
        "due": "Due",
        "status": "Status",
        "created_at": "Created"
      },
      "values": {
        "score": "importance * urgency"
      },
      "types": {
        "due": "time",
        "created_at": {
          "type": "time",
          "parse": "%Y-%m-%d %H:%M:%S"
        }
      },
      "tree": {
        "child": "parent_task_id",
        "parent": "task_id",
        "column": "task_id",
        "expand": "all",
        "filterScope": "all"
      },
      "sort": [
        "-score",
        "created_at"
      ],
      "filters": {
        "status": [
          "open"
        ]
      },
      "styles": {
        "score": [
          {
            "when": "value >= 16",
            "color": "#f44747",
            "bold": true
          },
          {
            "when": "value >= 9",
            "color": "#dcdcaa"
          },
          {
            "color": "#858585"
          }
        ],
        "status": [
          {
            "when": "value == 'complete'",
            "color": "#4ec9b0"
          }
        ]
      },
      "rowStyle": [
        {
          "when": "status == 'complete'",
          "color": "#858585",
          "strike": true
        }
      ],
      "select": {
        "state": "selected_task"
      },
      "buttons": [
        {
          "label": "New",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "New Task",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "title",
                  "label": "Title",
                  "type": "text",
                  "required": true,
                  "placeholder": "What needs doing?"
                },
                {
                  "row": [
                    {
                      "name": "importance",
                      "label": "Importance",
                      "type": "select",
                      "width": 0.5,
                      "value": 3,
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    },
                    {
                      "name": "urgency",
                      "label": "Urgency",
                      "type": "select",
                      "width": 0.5,
                      "value": 3,
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "due",
                  "label": "Due (YYYY-MM-DD, optional)",
                  "type": "text",
                  "placeholder": "2026-12-31",
                  "value": ""
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": ""
                }
              ],
              "submit": {
                "label": "Create",
                "service": "tasks",
                "op": "add"
              }
            }
          }
        },
        {
          "label": "Split",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Split Task ID ${row.task_id}",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "parent_task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "label": "Parent",
                  "type": "readonly",
                  "value": "${row.title}"
                },
                {
                  "name": "title",
                  "label": "Child task title",
                  "type": "text",
                  "required": true,
                  "placeholder": "What part of it needs doing?"
                },
                {
                  "row": [
                    {
                      "name": "importance",
                      "label": "Importance",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.importance}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    },
                    {
                      "name": "urgency",
                      "label": "Urgency",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.urgency}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "due",
                  "label": "Due (YYYY-MM-DD, optional)",
                  "type": "text",
                  "placeholder": "2026-12-31",
                  "value": "${row.due}"
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": ""
                }
              ],
              "submit": {
                "label": "Split",
                "service": "tasks",
                "op": "split"
              }
            }
          }
        },
        {
          "label": "Edit",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Edit Task ID ${row.task_id}",
              "modal": true,
              "width": 440,
              "fields": [
                {
                  "name": "task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "name": "updated_at",
                  "type": "hidden",
                  "value": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
                },
                {
                  "name": "title",
                  "label": "Title",
                  "type": "text",
                  "required": true,
                  "placeholder": "What needs doing?",
                  "value": "${row.title}"
                },
                {
                  "row": [
                    {
                      "name": "importance",
                      "label": "Importance",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.importance}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    },
                    {
                      "name": "urgency",
                      "label": "Urgency",
                      "type": "select",
                      "width": 0.5,
                      "value": "${row.urgency}",
                      "options": [
                        {
                          "value": 1,
                          "label": "1 - Lowest"
                        },
                        {
                          "value": 2,
                          "label": "2 - Low"
                        },
                        {
                          "value": 3,
                          "label": "3 - Medium"
                        },
                        {
                          "value": 4,
                          "label": "4 - High"
                        },
                        {
                          "value": 5,
                          "label": "5 - Highest"
                        }
                      ]
                    }
                  ]
                },
                {
                  "name": "due",
                  "label": "Due (YYYY-MM-DD, optional)",
                  "type": "text",
                  "placeholder": "2026-12-31",
                  "value": "${row.due}"
                },
                {
                  "name": "notes",
                  "label": "Notes",
                  "type": "textarea",
                  "value": "${row.notes}"
                }
              ],
              "submit": {
                "label": "Save",
                "service": "tasks",
                "op": "edit"
              }
            }
          }
        },
        {
          "label": "Complete",
          "enable": {
            "connected": true,
            "minSelected": 1,
            "when": "ALL(rows, r -> r.status == 'open')"
          },
          "action": {
            "type": "transaction",
            "service": "tasks",
            "op": "complete",
            "data": {
              "task_id": "${row.task_id}",
              "completed_at": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}",
              "updated_at": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
            }
          }
        },
        {
          "label": "Reopen",
          "enable": {
            "connected": true,
            "minSelected": 1,
            "when": "ALL(rows, r -> r.status == 'complete')"
          },
          "action": {
            "type": "transaction",
            "service": "tasks",
            "op": "reopen",
            "data": {
              "task_id": "${row.task_id}",
              "updated_at": "${TIME(NOW(), '%Y-%m-%d %H:%M:%S')}"
            }
          }
        },
        {
          "label": "Delete",
          "unit": "row",
          "enable": {
            "connected": true
          },
          "style": [
            {
              "when": "enabled",
              "background": "#c62828",
              "color": "#fff"
            }
          ],
          "action": {
            "type": "dialog",
            "dialog": {
              "title": "Delete Task ID ${row.task_id}",
              "modal": true,
              "width": 380,
              "fields": [
                {
                  "name": "task_id",
                  "type": "hidden",
                  "value": "${row.task_id}"
                },
                {
                  "label": "Delete this task and every task split from it?",
                  "type": "readonly",
                  "value": "${row.title}"
                }
              ],
              "submit": {
                "label": "Delete",
                "service": "tasks",
                "op": "delete"
              }
            }
          }
        }
      ]
    },
    "task-detail": {
      "title": "Detail",
      "widgets": [
        {
          "type": "text",
          "text": "${IF(state.selected_task == NULL, 'Select a task to see its notes.', FORMAT('{}  {}', state.selected_task.task_id, state.selected_task.title))}",
          "class": "task-detail-title"
        },
        {
          "type": "text",
          "text": "${IF(state.selected_task == NULL || state.selected_task.parent_task_id == '', '', CONCAT('Split from Task ID ', state.selected_task.parent_task_id))}",
          "class": "task-detail-parent"
        },
        {
          "type": "text",
          "text": "${IF(state.selected_task == NULL, '', state.selected_task.notes)}",
          "class": "task-detail-notes"
        }
      ]
    }
  },
  "frames": [
    {
      "id": "main",
      "x": 0.02,
      "y": 0.03,
      "w": 0.64,
      "h": 0.94,
      "layout": {
        "type": "tabs",
        "active": 0,
        "children": [
          "tasks"
        ]
      }
    },
    {
      "id": "side",
      "x": 0.68,
      "y": 0.03,
      "w": 0.3,
      "h": 0.94,
      "layout": {
        "type": "tabs",
        "active": 0,
        "children": [
          "task-detail"
        ]
      }
    }
  ],
  "mkio": {
    "url": "auto",
    "expect": {
      "name": "mktask",
      "expr": "1"
    },
    "connected": {
      "status.message": "Connected",
      "status.color": null,
      "status.background": null
    },
    "disconnected": {
      "status.message": "Disconnected",
      "status.color": "#000",
      "status.background": "#858585"
    },
    "incompatible": {
      "status.message": "Server mismatch",
      "status.color": "#fff",
      "status.background": "#cc0000"
    }
  }
}
